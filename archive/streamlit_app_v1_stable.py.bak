import pandas as pd
import plotly.express as px
import streamlit as st
from io import BytesIO

# ---------- 1. Page Configuration ----------
st.set_page_config(
    page_title="PV LCA Decision Tool",
    page_icon="☀️",
    layout="wide",
    initial_sidebar_state="expanded"
)

# --- MINIMALIST CSS (Performance Focused) ---
# No heavy blur effects. Just clean padding and spacing.
st.markdown("""
<style>
    /* Add some breathing room at the top */
    .block-container {
        padding-top: 2rem;
    }
    /* Metric cards styling for better visibility */
    [data-testid="stMetricValue"] {
        font-size: 1.8rem !important;
    }
</style>
""", unsafe_allow_html=True)

# ---------- 2. Robust Data Loading ----------
WB = "EPD_Hub_V3_PV_master_curated_v1.xlsx"
TARGET_SHEET = "INDICATORS_NORMALIZED"

@st.cache_data
def load_and_clean_data():
    try:
        # Load Excel
        xl = pd.ExcelFile(WB)
        sheet_names = xl.sheet_names
        
        # Smart Sheet Selection
        load_sheet = TARGET_SHEET if TARGET_SHEET in sheet_names else sheet_names[0]
        df = pd.read_excel(WB, sheet_name=load_sheet)
        
        # --- CRITICAL FIX: Force Numeric Types ---
        numeric_cols = [
            'module_power_Wp', 'module_area_m2',
            'GWP_total_A1A3_per_DU_kgCO2e', 'GWP_total_A1A3_per_kWp_kgCO2e',
            'GWP_total_A1A3_per_m2_kgCO2e', 'GWP_total_A1A3_per_module_kgCO2e'
        ]
        for col in numeric_cols:
            if col in df.columns:
                df[col] = pd.to_numeric(df[col], errors='coerce')

        # Create a clean display name
        if 'manufacturer' in df.columns and 'name' in df.columns:
            df['Display_Name'] = df.apply(
                lambda x: f"{x['manufacturer']} - {str(x['name'])[:30]}...", axis=1
            )
        else:
            df['Display_Name'] = df.index.astype(str)

        # Data Quality Score
        def score_quality(row):
            score = 1
            if pd.notna(row.get('module_power_Wp')) and row['module_power_Wp'] > 0: score += 1
            if pd.notna(row.get('module_area_m2')) and row['module_area_m2'] > 0: score += 1
            if pd.notna(row.get('source')) and '.pdf' in str(row['source']).lower(): score += 1
            if pd.notna(row.get('version')): score += 1
            return score

        df['Quality_Score'] = df.apply(score_quality, axis=1)
        df['Quality_Stars'] = df['Quality_Score'].apply(lambda x: "⭐" * x)
        
        # Handle Source Column for Export
        if 'source' in df.columns:
            df = df.rename(columns={'source': 'Source_PDF'})

        return df
    
    except FileNotFoundError:
        st.error(f"❌ Error: The file '{WB}' was not found.")
        return pd.DataFrame()
    except Exception as e:
        st.error(f"🔥 Critical Error Loading Data: {e}")
        return pd.DataFrame()

df_master = load_and_clean_data()

if df_master.empty:
    st.stop()

# ---------- 3. Sidebar Control Panel ----------
st.sidebar.title("Project Simulator")

with st.sidebar.expander("🏗️ Project Settings", expanded=True):
    project_size_mw = st.number_input("Project Size (MWp)", 0.1, 100.0, 10.0, step=0.5)
    irradiance = st.number_input("Specific Yield (kWh/kWp/yr)", 500, 2500, 1000)
    lifetime = st.slider("System Lifetime (Years)", 15, 40, 30)

with st.sidebar.expander("⚡ Grid Settings", expanded=False):
    grid_intensity = st.number_input("Grid Carbon Intensity (gCO2e/kWh)", 0, 1000, 400)

st.sidebar.divider()
st.sidebar.header("🔍 Filters")

# Filters
if 'manufacturer' in df_master.columns:
    manufacturers = sorted(df_master['manufacturer'].dropna().astype(str).unique())
    selected_mfg = st.sidebar.multiselect("Filter Manufacturer", manufacturers)
else:
    selected_mfg = []

search_txt = st.sidebar.text_input("Search Model Name")

# Apply Filters
df_filtered = df_master.copy()
if selected_mfg:
    df_filtered = df_filtered[df_filtered['manufacturer'].astype(str).isin(selected_mfg)]
if search_txt and 'name' in df_filtered.columns:
    df_filtered = df_filtered[df_filtered['name'].astype(str).str.contains(search_txt, case=False)]

# Prepare Calculation Dataframe
if 'GWP_total_A1A3_per_kWp_kgCO2e' not in df_filtered.columns:
    st.error("Critical Column 'GWP_total_A1A3_per_kWp_kgCO2e' missing.")
    st.stop()

df_calc = df_filtered.dropna(subset=['GWP_total_A1A3_per_kWp_kgCO2e'])

# Calculations
if not df_calc.empty:
    # Carbon Intensity
    df_calc['Carbon_Intensity_g_kWh'] = (
        df_calc['GWP_total_A1A3_per_kWp_kgCO2e'] * 1000
    ) / (irradiance * lifetime)

    # Carbon Payback Time
    df_calc['CPT_Years'] = (
        df_calc['GWP_total_A1A3_per_kWp_kgCO2e'] * 1000
    ) / (irradiance * grid_intensity)

    # Total Project Footprint
    df_calc['Project_Total_tCO2e'] = df_calc['GWP_total_A1A3_per_kWp_kgCO2e'] * project_size_mw * 1000 / 1000

    # Identify Best
    df_calc = df_calc.sort_values('Carbon_Intensity_g_kWh')
    best_module = df_calc.iloc[0]
else:
    st.warning("No valid data found with current filters.")
    st.stop()

# ---------- 5. Main UI Layout ----------

st.title("PV Lifecycle Assessment Dashboard")

tab1, tab2, tab3 = st.tabs(["📊 Dashboard", "📈 Sensitivity", "💾 Raw Data"])

# === TAB 1: DASHBOARD ===
with tab1:
    st.markdown(f"**Scenario:** {project_size_mw} MW Project | {irradiance} kWh/kWp yield | {lifetime} Years")
    st.divider()

    k1, k2, k3, k4 = st.columns(4)
    k1.metric("Lowest Carbon Intensity", f"{best_module['Carbon_Intensity_g_kWh']:.2f} g/kWh", "Best Option")
    k2.metric("Carbon Payback Time", f"{best_module['CPT_Years']:.2f} Years")
    k3.metric("Total Project Footprint", f"{best_module['Project_Total_tCO2e']:,.0f} tCO₂e")
    mfg_name = best_module['manufacturer'] if 'manufacturer' in best_module else "N/A"
    k4.metric("Top Manufacturer", mfg_name)

    st.divider()

    c1, c2 = st.columns([2, 1])
    
    with c1:
        st.subheader("Carbon Intensity Ranking (gCO₂e/kWh)")
        fig = px.bar(
            df_calc.head(15),
            x='Carbon_Intensity_g_kWh',
            y='Display_Name',
            orientation='h',
            color='Carbon_Intensity_g_kWh',
            color_continuous_scale='RdYlGn_r',
            labels={'Carbon_Intensity_g_kWh': 'Carbon Intensity (gCO₂e/kWh)', 'Display_Name': 'Module'}
        )
        fig.update_layout(yaxis={'categoryorder':'total descending'}, height=500, margin=dict(l=0, r=0, t=30, b=0))
        st.plotly_chart(fig, use_container_width=True)

    with c2:
        st.subheader("Efficiency vs. Impact")
        if 'module_power_Wp' in df_calc.columns and 'module_area_m2' in df_calc.columns:
            # Safe copy for plotting
            plot_df = df_calc.copy()
            plot_df['module_power_Wp'] = plot_df['module_power_Wp'].fillna(0)
            plot_df['module_area_m2'] = plot_df['module_area_m2'].fillna(2.0)
            
            fig2 = px.scatter(
                plot_df,
                x='module_power_Wp',
                y='GWP_total_A1A3_per_kWp_kgCO2e',
                color='manufacturer' if 'manufacturer' in plot_df.columns else None,
                size='module_area_m2',
                hover_name='name',
                labels={'module_power_Wp': 'Power (Wp)', 'GWP_total_A1A3_per_kWp_kgCO2e': 'GWP (kgCO2e/kWp)'},
            )
            st.plotly_chart(fig2, use_container_width=True)
        else:
            st.info("Power or Area data missing for scatter plot.")

# === TAB 2: SENSITIVITY ===
with tab2:
    st.header("Scenario Modeling")
    st.write("Simulate how panel degradation affects total lifetime emissions per kWh.")
    
    col_s1, col_s2 = st.columns(2)
    with col_s1:
        deg_rate = st.slider("Annual Degradation Rate (%)", 0.2, 1.5, 0.55, 0.05)
        years = list(range(1, lifetime + 1))
        yield_factors = [(1 - (deg_rate/100))**(y-1) for y in years]
        lifetime_yield_factor = sum(yield_factors)
        st.info(f"**Effective Full-Load Years:** {lifetime_yield_factor:.2f} years")
        
    with col_s2:
        df_sens = df_calc.copy()
        df_sens['Adj_Intensity'] = (df_sens['GWP_total_A1A3_per_kWp_kgCO2e'] * 1000) / (irradiance * lifetime_yield_factor)
        best_sens = df_sens.sort_values('Adj_Intensity').iloc[0]
        
        st.metric("Adjusted Carbon Intensity (Best)", f"{best_sens['Adj_Intensity']:.2f} g/kWh")
        st.metric("Increase vs Base", f"+{(best_sens['Adj_Intensity'] - best_module['Carbon_Intensity_g_kWh']):.2f} g/kWh")

    st.divider()
    st.subheader("Lifetime Impact Analysis")
    
    if len(df_calc) > 0:
        top_3_mods = df_calc.sort_values('GWP_total_A1A3_per_kWp_kgCO2e').head(3)
        
        life_range = list(range(15, 41, 5))
        lines_data = []
        
        for _, row in top_3_mods.iterrows():
            for l in life_range:
                val = (row['GWP_total_A1A3_per_kWp_kgCO2e'] * 1000) / (irradiance * l)
                lines_data.append({'Module': row['manufacturer'], 'Years': l, 'Intensity_g_kWh': val})
                
        if lines_data:
            df_lines = pd.DataFrame(lines_data)
            fig_line = px.line(df_lines, x='Years', y='Intensity_g_kWh', color='Module', markers=True,
                               title="Carbon Intensity vs. System Lifetime")
            fig_line.update_layout(height=400)
            st.plotly_chart(fig_line, use_container_width=True)
    else:
        st.warning("No data available for sensitivity analysis.")

# === TAB 3: DATA EXPORT ===
with tab3:
    st.header("Raw Data Explorer")
    
    # Define Display Columns (Source_PDF HIDDEN)
    display_cols = [
        'manufacturer', 'name', 'module_power_Wp', 
        'GWP_total_A1A3_per_kWp_kgCO2e', 'Carbon_Intensity_g_kWh', 
        'Project_Total_tCO2e', 'Quality_Stars'
    ]
    
    # Define Download Columns (Source_PDF INCLUDED)
    download_cols = display_cols + ['Source_PDF']
    
    final_display_cols = [c for c in display_cols if c in df_calc.columns]
    final_download_cols = [c for c in download_cols if c in df_calc.columns]
    
    # Table
    st.dataframe(
        df_calc[final_display_cols].style.background_gradient(subset=['Carbon_Intensity_g_kWh'], cmap='RdYlGn_r'),
        use_container_width=True,
        height=600
    )
    
    # Download
    def to_excel(df):
        output = BytesIO()
        with pd.ExcelWriter(output, engine='xlsxwriter') as writer:
            df.to_excel(writer, index=False, sheet_name='Results')
        return output.getvalue()

    st.download_button(
        "📥 Download Results as Excel (Includes Source PDF)",
        data=to_excel(df_calc[final_download_cols]),
        file_name=f"PV_LCA_Results_{project_size_mw}MW.xlsx",
        mime="application/vnd.ms-excel"
    )