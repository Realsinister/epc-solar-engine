{"processInformation": {"dataSetInformation": {"UUID": "f518d04d-4805-4d97-b457-9920226f3ff4", "name": {"baseName": [{"value": " LCO White Clinker Bulk Plant Oggaz", "lang": "en"}]}, "classificationInformation": {"classification": [{"class": [{"value": "Mineralische Baustoffe", "level": 0, "classId": "1"}, {"value": "Bindemittel", "level": 1, "classId": "1.1"}, {"value": "Zement", "level": 2, "classId": "1.1.01"}], "name": "OEKOBAU.DAT"}, {"class": [{"value": "01 Basic materials and preliminary products", "level": 0}, {"value": "Cement, Building lime and other binders", "level": 1}, {"value": "Cement", "level": 2}], "name": "IBUCategories"}]}, "generalComment": [{"value": " LCO White Clinker is a Portland cement clinker that is manufactured and monitored in accordance with EN 197-1.\nPortland cement clinker is a hydraulic material that is primarily used to make cement. It consists of non-metallic inorganic materials. Finely ground, it forms a suspension when water is added, which solidifies and hardens both in air and under water due to the onset of a hydration reaction and remains permanently solid. The composition of the product corresponds to the specifications of EN 197-1.", "lang": "en"}], "other": {"anies": [{"componentsAndMaterialsAndSubstances": [{"component": {"name": [{"value": "Clinker", "lang": "en"}], "weightPerc": {"lowerValue": 100.0, "upperValue": 100.0}, "mass": {}, "comment": [{"value": "Clinker", "lang": "en"}, {"value": "Clinker", "lang": "en"}]}}]}]}}, "quantitativeReference": {"referenceToReferenceFlow": [0]}, "time": {"referenceYear": 2025, "dataSetValidUntil": 2030, "other": {"anies": [{"name": "publicationDateOfEPD", "value": 1750896000000}]}}, "geography": {"locationOfOperationSupplyOrProduction": {"location": "DZ"}}, "technology": {"technologyDescriptionAndIncludedProcesses": [{"value": " LCO White Clinker is manufactured at the Oggaz plant.\nProduction of Portland cement clinker\nLimestone, marl, clay or their natural mixture, are required for the production of Portland cement clinker. These starting materials are mined in quarries, pre-crushed and transported to the nearby cement works. There they are homogenized into an intermediate product, with additional natural or secondary corrective substances being added to fine-tune the chemical composition. In the subsequent heating process, the Portland cement clinker is produced from the intermediate product. The firing process takes place in a rotary kiln, where the material is thermally converted at around 1450 °C and then rapidly cooled. The finished clinker is stored in silos.\nThe Oggaz plant is ISO 9001 certified.\n", "lang": "en"}], "technologicalApplicability": [{"value": " LCO White Clinker is mainly used as a binder in the manufacture of cement.", "lang": "en"}], "referenceToTechnologyFlowDiagrammOrPicture": [{"shortDescription": [{"value": "Process Flow", "lang": "en"}], "type": "source data set", "refObjectId": "198076ae-41b8-4124-087b-08da6f224d27"}]}}, "modellingAndValidation": {"LCIMethodAndAllocation": {"typeOfDataSet": "EPD", "referenceToLCAMethodDetails": [{"shortDescription": [{"value": "Zement.pdf", "lang": "en"}], "type": "source data set", "refObjectId": "c500590c-58f3-4aa8-b2d4-5e989be21b1b", "version": "00.01.000"}], "other": {"anies": [{"name": "subType", "value": "specific dataset"}]}}, "dataSourcesTreatmentAndRepresentativeness": {"referenceToDataSource": [{"shortDescription": [{"value": "EcoInvent", "lang": "en"}], "type": "source data set", "refObjectId": "b497a91f-e14b-4b69-8f28-f50eb1576766"}], "useAdviceForDataSet": [{"value": "This environmental product declaration shows the life cycle assessment of the production of of Portland cement clinkers at the Oggaz plant of Lafarge Ciment Oggaz (LCO).\n\nType of EPD: cradle-to-factory gate\n\nThe system boundaries include the manufacture of  LCO White Clinker including the extraction of raw materials through to the finished product at the factory gate. The product stage includes:\n\nModule A1: Extraction and processing of raw materials.\nModule A2: Transport of raw materials to the factory gate and internal transport.\nModule A3: Manufacture of cement or cementitious components.\n\nThe construction stage, the usage stage and the disposal stage are not taken into account in the life cycle assessment for cement.", "lang": "en"}], "other": {"anies": [{"name": "referenceToOriginalEPD", "value": {"shortDescription": {"value": " LCO White Clinker Bulk Plant Oggaz", "defaultValue": " LCO White Clinker Bulk Plant Oggaz", "lstrings": [{"lang": "en", "value": " LCO White Clinker Bulk Plant Oggaz"}]}, "version": {"version": 2001, "majorVersion": 0, "minorVersion": 2, "subMinorVersion": 1, "zero": false, "versionString": "00.02.001"}, "type": "source data set", "uuid": {"uuid": "f518d04d-4805-4d97-b457-9920226f3ff4"}, "refObjectId": "f518d04d-4805-4d97-b457-9920226f3ff4", "versionAsString": "00.02.001", "resourceURLs": ["https://oekobaudat.de/OEKOBAU.DAT/resource/sources/f518d04d-4805-4d97-b457-9920226f3ff4/OriginalEPD.pdf?version=00.02.001"]}}]}}, "validation": {"review": [{"referenceToNameOfReviewerAndInstitution": [{"shortDescription": [{"value": "Matthias Schulz", "lang": "en"}], "type": "contact data set", "refObjectId": "8184d8aa-0045-43e5-a2c9-658acc9720de"}]}]}, "complianceDeclarations": {"compliance": [{"referenceToComplianceSystem": {"shortDescription": [{"value": "ISO 14025", "lang": "en"}], "type": "source data set", "refObjectId": "4f2eb655-6e44-4874-a95a-e28f5442cd4d"}}, {"referenceToComplianceSystem": {"shortDescription": [{"value": "EN 15804+A2", "lang": "en"}], "type": "source data set", "refObjectId": "c0016b33-8cf7-415c-ac6e-deba0d21440d"}}]}}, "administrativeInformation": {"dataGenerator": {"referenceToPersonOrEntityGeneratingTheDataSet": [{"shortDescription": [{"value": "Climate Earth, Inc.", "lang": "en"}], "type": "contact data set", "refObjectId": "4a3c46d9-30d8-4105-a89e-0e104067f5db"}]}, "dataEntryBy": {"timeStamp": 175094242