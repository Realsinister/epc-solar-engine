{"processInformation": {"dataSetInformation": {"UUID": "5d890c1b-8f10-4714-adb6-0fa2064bc57a", "name": {"baseName": [{"value": "Holcim Solido Bagged Plant Davao", "lang": "en"}]}, "classificationInformation": {"classification": [{"class": [{"value": "Mineralische Baustoffe", "level": 0, "classId": "1"}, {"value": "Bindemittel", "level": 1, "classId": "1.1"}, {"value": "Zement", "level": 2, "classId": "1.1.01"}], "name": "OEKOBAU.DAT"}, {"class": [{"value": "01 Basic materials and preliminary products", "level": 0}, {"value": "Cement, Building lime and other binders", "level": 1}, {"value": "Cement", "level": 2}], "name": "IBUCategories"}]}, "generalComment": [{"value": "Holcim Solido is a Portland-pozzolan cement composed mostly of clinker and pozzolan which is produced and monitored according to PNS 63.\n\nIt consists of a mixture of finely ground, non-metallic, inorganic components. After adding water to the cement, a suspension (cement paste) is formed, which solidifies and hardens both in air and under water due to the onset of a hydration reaction and remains permanently solid.\n\nThis cement is a hydraulically hardening binder for the production of concrete and mortar.", "lang": "en"}], "other": {"anies": [{"componentsAndMaterialsAndSubstances": [{"component": {"name": [{"value": "Clinker", "lang": "en"}], "weightPerc": {"lowerValue": 60.0, "upperValue": 99.0}, "mass": {}, "comment": [{"value": "Clinker", "lang": "en"}, {"value": "Clinker", "lang": "en"}]}}, {"component": {"name": [{"value": "Limestone", "lang": "en"}], "weightPerc": {"lowerValue": 0.0, "upperValue": 5.0}, "mass": {}, "comment": [{"value": "Limestone", "lang": "en"}, {"value": "Limestone", "lang": "en"}]}}, {"component": {"name": [{"value": "Slag", "lang": "en"}], "weightPerc": {"lowerValue": 0.0, "upperValue": 15.0}, "mass": {}, "comment": [{"value": "Blast furnace slag", "lang": "en"}, {"value": "Blast furnace slag", "lang": "en"}]}}, {"component": {"name": [{"value": "Fly Ash", "lang": "en"}], "weightPerc": {"lowerValue": 0.0, "upperValue": 10.0}, "mass": {}, "comment": [{"value": "Fly ash", "lang": "en"}, {"value": "Fly ash", "lang": "en"}]}}, {"component": {"name": [{"value": "Pozzolan", "lang": "en"}], "weightPerc": {"lowerValue": 1.0, "upperValue": 40.0}, "mass": {}, "comment": [{"value": "Pozzolan", "lang": "en"}, {"value": "Pozzolan", "lang": "en"}]}}, {"component": {"name": [{"value": "Minor", "lang": "en"}], "weightPerc": {"lowerValue": 0.0, "upperValue": 5.0}, "mass": {}, "comment": [{"value": "Minor constituents (+ Gypsum / Anhydrite)", "lang": "en"}, {"value": "Minor constituents (+ Gypsum / Anhydrite)", "lang": "en"}]}}]}]}}, "quantitativeReference": {"referenceToReferenceFlow": [0]}, "time": {"referenceYear": 2024, "dataSetValidUntil": 2029, "other": {"anies": [{"name": "publicationDateOfEPD", "value": 1724630400000}]}}, "geography": {"locationOfOperationSupplyOrProduction": {"location": "PH"}}, "technology": {"technologyDescriptionAndIncludedProcesses": [{"value": "Holcim Solido is manufactured at the Davao plant.\nProduction of Portland cement clinker\nLimestone, marl, clay or their natural mixture, are required for the production of Portland cement clinker. These starting materials are mined in quarries, pre-crushed and transported to the nearby cement works. There they are homogenized into an intermediate product, with additional natural or secondary corrective substances being added to fine-tune the chemical composition. In the subsequent heating process, the Portland cement clinker is produced from the intermediate product. The firing process takes place in a rotary kiln, where the material is thermally converted at around 1450 °C and then rapidly cooled. The finished clinker is stored in silos.\nProduction of blast furnace slag\nDuring the production of pig iron in the blast furnace process, liquid blast furnace slag is produced as a by-product at around 1500 °C. The slag is shock-cooled with water to produce a glass-like granulate with latent hydraulic properties. The blast furnace slag is then stored on heaps.\nExtraction of limestone\nThe limestone is extracted from natural deposits in opencast quarries.\nExtraction of pozzolan\nThe pozzolan (glassy rock of volcanic origin) is mined from natural quarries.Production of fly ash\nFly ash is a co-product of electricity generation in coal-fired thermal power plants.Cement Production\nTo produce the ready-to-sell cement {name}, the cement components are finely ground and combined. A sulfate carrier is added to control the setting behavior.\nThe Davao plant is ISO 9001 certified.\n", "lang": "en"}], "technologicalApplicability": [{"value": "Holcim Solido is used as a binder in the manufacture of concrete and mortar.", "lang": "en"}], "referenceToTechnologyFlowDiagrammOrPicture": [{"shortDescription": [{"value": "Process Flow", "lang": "en"}], "type": "source data set", "refObjectId": "871e75f7-b739-4398-36af-08db677a347d"}]}}, "modellingAndValidation": {"LCIMethodAndAllocation": {"typeOfDataSet": "EPD", "referenceToLCAMethodDetails": [{"shortDescription": [{"value": "Zement.pdf", "lang": "en"}], "type": "source data set", "refObjectId": "c500590c-58f3-4aa8-b2d4-5e989be21b1b", "version": "00.01.000"}], "other": {"anies": [{"name": "subType", "value": "specific dataset"}]}}, "dataSourcesTreatmentAndRepresentativeness": {"referenceToDataSource": [{"shortDescription": [{"value": "EcoInvent", "lang": "en"}], "type": "source data set", "refObjectId": "b497a91f-e14b-4b69-8f28-f50eb1576766"}], "useAdviceForDataSet": [{"value": "This environmental product declaration shows the life cycle assessment of the production of of Portland-Pozzolan Cements Holcim Solido (Type IP 25 MPa min) at the Davao plant of Holcim Philippines.\n\nType of EPD: cradle-to-factory gate\n\nThe system boundaries include the manufacture of Holcim Solido including the extraction of raw materials through to the finished product at the factory gate. The product stage includes:\n\nModule A1: Extraction and processing of raw materials.\nModule A2: Transport of raw materials to the factory gate and internal transport.\nModule A3: Manufacture of cement or cementitious components.\n\nThe construction stage, the usage stage and the disposal stage are not taken into account in the life cycle assessment for cement.", "lang": "en"}], "other": {"anies": [{"name": "referenceToOriginalEPD", "value": {"shortDescription": {"value": "Holcim Solido Bagged Plant Davao", "defaultValue": "Holcim Solido Bagged Plant Davao", "lstrings": [{"lang": "en", "value": "Holcim Solido Bagged Plant Davao"}]}, "version": {"version": 1002, "majorVersion": 0, "minorVersion": 1, "subMinorVersion": 2, "zero": false, "versionString": "00.01.002"}, "type": "source data set", "uuid": {"uuid": "5d890c1b-8f10-4714-adb6-0fa2064bc57a"}, "refObjectId": "5d890c1b-8f10-4714-adb6-0fa2064bc57a", "versionAsString": "00.01.002", "resourceURLs": ["https://oekobaudat.de/OEKOBAU.DAT/resource/sources/5d890c1b-8f10-4714-adb6-0fa2064bc57a/OriginalEPD.pdf?version=00.01.002"]}}]}}, "validation": {"review": [{"referenceToNameOfReviewerAndInstitution": [{"shortDescription": [{"value": "Matthias Schulz", "lang": "en"}], "type": "contact data set", "refObjectId": "8184d8aa-0045-43e5-a2c9-658acc9720de"}]}]}, "complianceDeclarations": {"compliance": [{"referenceToComplianceSystem": {"shortDescription": [{"value": "ISO 14025", "lang": "en"}], "type": "source data set", "refObjectId": "4f2eb655-6e44-4874-a95a-e28f5442cd4d"}}, {"referenceToComplianceSystem": {"shortDescription": [{"value": "EN 15804+A2", "lang": "en"}], "type": "source data set", "refObjectId": "c0016b33-8cf7-415c-ac6e-deba0d21440d"}}]}}, "administrativeInformation": {"dataGenerator": {"referenceToPersonOrEntityGeneratingTheDataSet": [{"shortDescription": [{"value": "Climate Earth, Inc.", "lang": "en"}], "type": "contact data set", "refObjectId": "4a3c46d9-30d8-4105-a89e-0e104067f5db"}]}, "dataEntryBy": {"timeStamp": 1749156443999, "referenceToD