{"processInformation": {"dataSetInformation": {"UUID": "d69a69ca-9323-4a28-81f7-ed8b457080c6", "name": {"baseName": [{"value": "Perlites 0-3", "lang": "en"}, {"value": "Perlite 0-3", "lang": "de"}], "functionalUnitFlowProperties": [{"value": "Grain size 0/3", "lang": "en"}]}, "classificationInformation": {"classification": [{"class": [{"value": "Mineralische Baustoffe", "level": 0, "classId": "1"}, {"value": "Zuschläge", "level": 1, "classId": "1.2"}, {"value": "Perlite", "level": 2, "classId": "1.2.07"}], "name": "oekobau.dat"}]}, "generalComment": [{"value": "This data set has been modeled according to the European Standard EN 15804+A2 for Sustainable Building. Results are depicted in modules that allow the structured expression of results over the entire life cycle.", "lang": "en"}, {"value": "Dieser Datensatz wurde nach dem European Standard EN 15804+A2 für Nachhaltiges Bauen modelliert. Ergebnisse werden in Modulen abgebildet, die den strukturierten Ausdruck von Ergebnissen über den gesamten Lebenszyklus zulassen.", "lang": "de"}], "other": {"anies": [{"margins": 20, "description": [{"value": "Product system depicted except for a few missing processes / flows. Technological, temporal and geographic representativeness partly given.", "lang": "en"}, {"value": "Produktsystem bis auf wenige Prozesse/Flüsse abgebildet. Technologische, zeitliche und geographische Repräsentativität teilweise gegeben.", "lang": "de"}]}]}}, "quantitativeReference": {"referenceToReferenceFlow": [100779], "type": "Reference flow(s)"}, "time": {"referenceYear": 2023, "dataSetValidUntil": 2026, "timeRepresentativenessDescription": [{"value": "Annual average", "lang": "en"}, {"value": "Jährlicher Durchschnitt", "lang": "de"}]}, "geography": {"locationOfOperationSupplyOrProduction": {"descriptionOfRestrictions": [{"value": "The data set represents the country specific situation in Germany, focusing on the main technologies, the region specific characteristics and / or import statistics.", "lang": "en"}, {"value": "Der Datensatz bildet die länderspezifische Situation in Deutschland ab. Dabei werden Haupttechnologien, spezifische regionale Charakteristiken und ggf. Importstatistiken berücksichtigt.", "lang": "de"}], "location": "DE"}}, "technology": {"technologyDescriptionAndIncludedProcesses": [{"value": "Expanded perlites are aqueous, volcanic glasses being expanded by the influence of heat. During the expansion process that material viscous in that moment is foamed up to a 20 times higher volume. After the sieving process, the material may pass through a water-repellent finishing process.   ", "lang": "en"}, {"value": "Blähperlite sind wasserhaltige, vulkanische Gläser und werden durch den Einfluss von Hitze aufgebläht. Während des Expansionsprozesses wird das in dem Moment dickflüssige Material zu einem 20-mal höheren Umfang aufgeschäumt. Nach der Siebung kann das Material ein wasserabweisendes Veredelungsverfahren durchlaufen.", "lang": "de"}], "technologicalApplicability": [{"value": "This product can be used in construction.", "lang": "en"}, {"value": "Dieses Produkt kann im Baubereich verwendet werden.", "lang": "de"}], "referenceToTechnologyFlowDiagrammOrPicture": [{"shortDescription": [{"value": "construction_08_perlite_fig.jpg", "lang": "en"}], "type": "source data set", "refObjectId": "7b727f01-4625-4a38-863f-30018e3ecc57", "version": "24.01.000", "uri": "../sources/7b727f01-4625-4a38-863f-30018e3ecc57.xml"}, {"shortDescription": [{"value": "construction_08_perlite_ingred.jpg", "lang": "en"}], "type": "source data set", "refObjectId": "e04aac1c-f647-4f2b-8f43-4e76ca9764e2", "version": "24.01.000", "uri": "../sources/e04aac1c-f647-4f2b-8f43-4e76ca9764e2.xml"}]}}, "modellingAndValidation": {"LCIMethodAndAllocation": {"typeOfDataSet": "EPD", "other": {"anies": [{"name": "subType", "value": "generic dataset"}]}}, "dataSourcesTreatmentAndRepresentativeness": {"referenceToDataSource": [{"shortDescription": [{"value": "Documentation of data quality management", "lang": "en"}], "type": "source data set", "refObjectId": "e3bd9bbf-2c3c-42aa-8892-fd13f1065ca5", "version": "24.01.000", "uri": "../sources/e3bd9bbf-2c3c-42aa-8892-fd13f1065ca5.xml"}, {"shortDescription": [{"value": "GaBi Database Edition 2021, CUP2021.01", "lang": "en"}], "type": "source data set", "refObjectId": "1cece811-7501-44d4-8067-9259bd5cb835", "version": "00.01.000", "uri": "../sources/1cece811-7501-44d4-8067-9259bd5cb835.xml"}, {"shortDescription": [{"value": "Sphera Managed LCA Content Databases (all versions)", "lang": "en"}], "type": "source data set", "refObjectId": "28d74cc0-db8b-4d7e-bc44-5f6d56ce0c4a", "version": "00.03.002", "uri": "../sources/28d74cc0-db8b-4d7e-bc44-5f6d56ce0c4a.xml"}], "useAdviceForDataSet": [{"value": "The data set represents a cradle to gate inventory. It can be used to characterise the supply chain situation of the respective commodity in a representative manner. Combination with individual unit processes using this commodity enables the generation of user-specific (product) LCAs.", "lang": "en"}, {"value": "Der Datensatz repräsentiert ein Cradle to Gate Inventar. Er kann verwendet werden, um die Lieferkette des jeweiligen Produktes in einer repräsentativen Weise zu charakterisieren. Die Kombination mit einzelnen Einheitenprozessen und diesem Produkt ermöglicht die Erstellung von anwenderspezifischen (Produkt-) LCAs.", "lang": "de"}]}, "validation": {"review": [{"referenceToNameOfReviewerAndInstitution": [{"shortDescription": [{"value": "Sphera Solutions GmbH", "lang": "en"}], "type": "contact data set", "refObjectId": "d7fa0337-f279-430d-becf-7f3111a85010", "version": "24.01.000", "uri": "../contacts/d7fa0337-f279-430d-becf-7f3111a85010.xml"}], "type": "Dependent internal review"}, {"referenceToNameOfReviewerAndInstitution": [{"shortDescription": [{"value": "Sphera Product Sustainability user forum", "lang": "en"}], "type": "contact data set", "refObjectId": "8f1306f0-7b83-4f36-a537-aa83f0498266", "version": "24